# Gere uma chave aleatória de pelo menos 32 bytes e mantenha-a apenas no
# provedor de hospedagem. Sem ela, o cofre falha fechado e não grava registros.
# Exemplo: openssl rand -base64 48
ENCRYPTION_KEY=
# Identifica a chave usada no registro para apoiar rotação futura (não é segredo).
ENCRYPTION_KEY_VERSION=v1

# Configure também os valores reais do seu projeto Supabase. A service role é
# usada somente no servidor para incorporar automaticamente o acervo histórico
# ao cofre e nunca pode ser exposta no navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: serviço de aprendizado de máquina.
ML_SERVICE_URL=

# Opcional: análise multimodal de obras públicas. Sem esta chave, o sistema
# registra apenas contexto catalográfico e não afirma análise visual por IA.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-1.5-flash

# Opcional: autoriza apenas worker/curadoria a anexar pulsos à cadeia já selada.
# Nunca exponha este valor ao navegador.
LIVE_VAULT_MUTATION_SECRET=
