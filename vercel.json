{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install --no-audit --no-fund --legacy-peer-deps --omit=optional --prefer-offline",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/ml-training",
      "schedule": "0 7 * * *"
    }
  ]
}
